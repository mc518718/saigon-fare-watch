# Supabase project credentials (browser-safe; access is gated by RLS).
# Set the same two variables in Vercel: Project Settings -> Environment Variables.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Flight API (AWS API Gateway). Public URL, no secret. Optional: the app falls back to the built-in default.
VITE_FLIGHT_API_URL="https://<api-id>.execute-api.us-east-1.amazonaws.com"
